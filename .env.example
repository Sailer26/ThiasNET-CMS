APP_ENV=development
SECRET_KEY=cambia-questa-chiave
DATABASE_URL=sqlite:///data/cms.db
THEMES_DIR=themes
ACTIVE_THEME=default
# File caricati: cartella fuori da themes/ e app/ (obbligatoria in produzione, D-74).
MEDIA_ROOT=data/media
MAX_UPLOAD_MB=15
# Immagini al massimo 25 megapixel (D-71); spazio per sito in MB (5 GB, D-78).
MEDIA_MAX_PIXELS=25000000
MEDIA_QUOTA_MB=5120
SITE_URL=http://localhost:5000
SITE_NAME=Nome del sito
# Email del modulo contatti (D-61). In produzione SMTP_SECURITY=starttls o ssl.
CONTACT_RECIPIENT=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
# Statistiche Matomo, solo dopo il consenso (D-66).
MATOMO_URL=
MATOMO_SITE_ID=

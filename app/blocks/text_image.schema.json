{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Testo e immagine",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "title": "Titolo",
      "maxLength": 200
    },
    "body": {
      "type": "string",
      "title": "Testo",
      "maxLength": 10000,
      "x-richtext": true
    },
    "media_id": {
      "type": "integer",
      "title": "Immagine",
      "minimum": 1,
      "x-media": "image"
    },
    "cta_label": {
      "type": "string",
      "title": "Testo del pulsante",
      "description": "Facoltativo. Se lo scrivi, serve anche il link.",
      "maxLength": 40
    },
    "cta_url": {
      "type": "string",
      "title": "Link del pulsante",
      "description": "Una pagina del sito (es. /contatti) oppure un indirizzo completo (https://…).",
      "maxLength": 2048,
      "format": "safe-url"
    }
  },
  "required": [
    "media_id"
  ],
  "dependentRequired": {
    "cta_label": [
      "cta_url"
    ],
    "cta_url": [
      "cta_label"
    ]
  }
}

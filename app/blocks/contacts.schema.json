{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contatti",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "intro": {
      "type": "string",
      "maxLength": 500
    },
    "address": {
      "type": "string",
      "maxLength": 300
    },
    "phone": {
      "type": "string",
      "maxLength": 30,
      "pattern": "^\\+?[0-9][0-9 ()./-]{2,29}$"
    },
    "email": {
      "type": "string",
      "maxLength": 254,
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    },
    "show_form": {
      "type": "boolean"
    }
  }
}

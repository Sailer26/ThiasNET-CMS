{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "youtube",
        "vimeo"
      ]
    },
    "video_id": {
      "type": "string",
      "maxLength": 12,
      "pattern": "^[A-Za-z0-9_-]{1,12}$"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    }
  },
  "required": [
    "provider",
    "video_id",
    "title"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "provider": {
            "const": "youtube"
          }
        },
        "required": [
          "provider"
        ]
      },
      "then": {
        "properties": {
          "video_id": {
            "pattern": "^[A-Za-z0-9_-]{11}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "const": "vimeo"
          }
        },
        "required": [
          "provider"
        ]
      },
      "then": {
        "properties": {
          "video_id": {
            "pattern": "^[0-9]{1,12}$"
          }
        }
      }
    }
  ]
}

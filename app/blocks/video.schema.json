{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "provider": {
      "type": "string",
      "title": "Piattaforma",
      "enum": [
        "youtube",
        "vimeo"
      ],
      "x-enum-titles": [
        "YouTube",
        "Vimeo"
      ]
    },
    "video_id": {
      "type": "string",
      "title": "Codice del video",
      "description": "La parte finale dell'indirizzo del video.",
      "maxLength": 12,
      "pattern": "^[A-Za-z0-9_-]{1,12}$"
    },
    "title": {
      "type": "string",
      "title": "Titolo del video",
      "description": "Serve a chi usa un lettore di schermo.",
      "maxLength": 200
    }
  },
  "required": [
    "provider",
    "video_id",
    "title"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "provider": {
            "const": "youtube"
          }
        },
        "required": [
          "provider"
        ]
      },
      "then": {
        "properties": {
          "video_id": {
            "pattern": "^[A-Za-z0-9_-]{11}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "const": "vimeo"
          }
        },
        "required": [
          "provider"
        ]
      },
      "then": {
        "properties": {
          "video_id": {
            "pattern": "^[0-9]{1,12}$"
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mappa",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lng": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "zoom": {
      "type": "integer",
      "minimum": 1,
      "maximum": 19,
      "default": 15
    },
    "label": {
      "type": "string",
      "maxLength": 120
    },
    "address": {
      "type": "string",
      "maxLength": 300
    }
  },
  "required": [
    "lat",
    "lng"
  ]
}

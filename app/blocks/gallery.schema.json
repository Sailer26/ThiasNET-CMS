{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Galleria",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "title": "Immagini",
      "description": "Le foto della galleria, nell'ordine in cui appaiono.",
      "minItems": 1,
      "maxItems": 48,
      "items": {
        "type": "object",
        "title": "Immagine",
        "additionalProperties": false,
        "properties": {
          "media_id": {
            "type": "integer",
            "title": "Immagine",
            "minimum": 1,
            "x-media": "image"
          },
          "caption": {
            "type": "string",
            "title": "Didascalia",
            "maxLength": 200
          }
        },
        "required": [
          "media_id"
        ]
      }
    }
  },
  "required": [
    "items"
  ]
}

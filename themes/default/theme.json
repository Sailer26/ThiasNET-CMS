{
  "name": "default",
  "version": "1.0.0",
  "author": "ThiasNET",
  "locales": ["it", "de", "rm", "en"],
  "layouts": {
    "home": {
      "label": "Homepage",
      "zones": {
        "hero": { "label": "Apertura", "blocks": ["hero"], "max": 1 },
        "main": { "label": "Contenuto principale", "blocks": ["heading", "text", "image", "text_image", "gallery", "cta", "quote", "video", "files", "map", "contacts", "divider"] }
      }
    },
    "page": {
      "label": "Pagina standard",
      "zones": {
        "main": { "label": "Contenuto principale", "blocks": ["heading", "text", "image", "text_image", "gallery", "cta", "quote", "video", "files", "map", "contacts", "divider"] },
        "sidebar": { "label": "Barra laterale", "blocks": ["text", "cta", "image"], "max": 4 }
      }
    },
    "full": {
      "label": "Pagina larga (senza sidebar)",
      "zones": {
        "main": { "label": "Contenuto principale", "blocks": ["heading", "text", "image", "text_image", "gallery", "cta", "quote", "video", "files", "map", "divider"] }
      }
    },
    "news_list": {
      "label": "Elenco notizie",
      "collection": "news",
      "zones": {
        "main": { "label": "Introduzione", "blocks": ["heading", "text", "image"], "max": 3 }
      }
    }
  },
  "widget_areas": {
    "header_top": { "label": "Barra superiore", "widgets": ["notice", "contacts_inline"] },
    "footer": { "label": "Piè di pagina", "widgets": ["hours", "contacts", "social", "latest_entries", "text"] },
    "sidebar": { "label": "Barra laterale", "widgets": ["hours", "latest_entries", "text", "cta"] }
  },
  "menus": {
    "main": { "label": "Menu principale", "max_depth": 2 },
    "footer": { "label": "Menu footer", "max_depth": 1 }
  },
  "collections": {
    "news": {
      "label": "Notizie",
      "per_page": 10,
      "fields": {
        "date": { "type": "date", "label": "Data", "required": true },
        "cover": { "type": "media", "label": "Immagine di copertina" },
        "summary": { "type": "textarea", "label": "Riassunto", "max": 300 },
        "body": { "type": "richtext", "label": "Testo" }
      }
    }
  },
  "image_sizes": {
    "thumb": { "width": 320, "ratio": "1:1" },
    "card": { "width": 640, "ratio": "4:3" },
    "content": { "width": 1024 },
    "hero": { "width": 1920, "ratio": "16:9" }
  },
  "block_variants": {
    "hero": {
      "default": "image_full",
      "options": {
        "image_full": { "label": "Immagine a tutta larghezza", "thumbnail": "variants/hero-image_full.png" },
        "split": { "label": "Testo e immagine affiancati", "thumbnail": "variants/hero-split.png" }
      }
    },
    "text_image": {
      "default": "image_left",
      "options": {
        "image_left": { "label": "Immagine a sinistra", "thumbnail": "variants/text_image-image_left.png" },
        "image_right": { "label": "Immagine a destra", "thumbnail": "variants/text_image-image_right.png" },
        "dark": { "label": "Sfondo scuro", "thumbnail": "variants/text_image-dark.png" }
      }
    },
    "cta": {
      "default": "light",
      "options": {
        "light": { "label": "Chiaro", "thumbnail": "variants/cta-light.png" },
        "accent": { "label": "Colore principale", "thumbnail": "variants/cta-accent.png" },
        "dark": { "label": "Scuro", "thumbnail": "variants/cta-dark.png" }
      }
    },
    "quote": {
      "default": "simple",
      "options": {
        "simple": { "label": "Semplice", "thumbnail": "variants/quote-simple.png" },
        "highlight": { "label": "In evidenza", "thumbnail": "variants/quote-highlight.png" }
      }
    },
    "gallery": {
      "default": "grid_3",
      "options": {
        "grid_3": { "label": "Tre colonne", "thumbnail": "variants/gallery-grid_3.png" },
        "grid_4": { "label": "Quattro colonne", "thumbnail": "variants/gallery-grid_4.png" }
      }
    }
  },
  "settings": {
    "accent_color": { "type": "color", "label": "Colore principale", "palette": ["#0B5FFF", "#1F7A4D", "#B3261E", "#6B4EFF", "#202124"], "default": "#0B5FFF" },
    "show_breadcrumbs": { "type": "boolean", "label": "Mostra percorso di navigazione", "default": true },
    "header_style": { "type": "select", "label": "Stile header", "options": ["light", "dark"], "default": "light" },
    "footer_note": { "type": "text", "label": "Nota nel footer", "max": 120 }
  }
}

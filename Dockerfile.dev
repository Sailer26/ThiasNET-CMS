# Ambiente di sviluppo. Il Dockerfile di produzione multi-stage arriva in Fase 8.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_ENV=development

WORKDIR /srv/app

RUN pip install --no-cache-dir \
        "Flask==3.1.3" "Flask-SQLAlchemy==3.1.1" "SQLAlchemy==2.1.4" "Flask-Migrate==4.1.0" \
        "jsonschema==4.26.0" "python-dotenv==1.2.4" \
    && useradd --create-home --uid 1000 cms \
    && mkdir -p /srv/app/data && chown cms /srv/app/data

USER cms
EXPOSE 5000
CMD ["python", "-m", "flask", "--app", "app", "run", "--debug", "--host", "0.0.0.0", "--port", "5000"]
